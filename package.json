{
  "name": "randi-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:randi-chat": "npm --prefix apps/randi-chat run dev",
    "build:randi-chat": "npm --prefix apps/randi-chat run build",
    "test:randi-chat": "npm --prefix apps/randi-chat run test"
  }
}
